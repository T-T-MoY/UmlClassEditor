<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:windowBackground"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".view.MethodEditorFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/edit_method_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_method_management"
            android:textColor="?attr/colorPrimary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/subtitle_method_management"
            android:textColor="?attr/colorSecondary"
            android:textSize="14sp" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:textColorHint="?attr/colorSecondary"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="?attr/colorPrimary"
                app:hintTextColor="?attr/colorPrimary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/method_name_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_method_name"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/label_visibility"
                android:textColor="?attr/colorSecondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:scrollbars="none">

                <RadioGroup
                    android:id="@+id/method_visibility_radio_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/method_public_radio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:buttonTint="?attr/colorPrimary"
                        android:checked="true"
                        android:text="@string/visibility_public"
                        android:textColor="?android:textColorPrimary" />

                    <RadioButton
                        android:id="@+id/method_protected_radio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:buttonTint="?attr/colorPrimary"
                        android:text="@string/visibility_protected"
                        android:textColor="?android:textColorPrimary" />

                    <RadioButton
                        android:id="@+id/method_private_radio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="?attr/colorPrimary"
                        android:text="@string/visibility_private"
                        android:textColor="?android:textColorPrimary" />
                </RadioGroup>
            </HorizontalScrollView>

            <CheckBox
                android:id="@+id/method_static_check"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:buttonTint="?attr/colorPrimary"
                android:text="@string/label_static"
                android:textColor="?android:textColorPrimary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:text="@string/label_return_type"
                    android:textColor="?attr/colorSecondary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_spinner_modern"
                    android:backgroundTint="?android:windowBackground"
                    android:padding="2dp">

                    <Spinner
                        android:id="@+id/method_type_spinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:popupBackground="?attr/colorSurface" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <RadioGroup
                    android:id="@+id/method_multiplicity_radio_group"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/method_simple_radio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="?attr/colorPrimary"
                        android:checked="true"
                        android:text="@string/multiplicity_single"
                        android:textColor="?android:textColorPrimary" />

                    <RadioButton
                        android:id="@+id/method_collection_radio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="?attr/colorPrimary"
                        android:text="@string/multiplicity_collection"
                        android:textColor="?android:textColorPrimary" />

                    <RadioButton
                        android:id="@+id/method_array_radio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="?attr/colorPrimary"
                        android:text="@string/multiplicity_array"
                        android:textColor="?android:textColorPrimary" />
                </RadioGroup>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:textColorHint="?attr/colorSecondary"
                    app:boxCornerRadiusBottomEnd="8dp"
                    app:boxCornerRadiusBottomStart="8dp"
                    app:boxCornerRadiusTopEnd="8dp"
                    app:boxCornerRadiusTopStart="8dp"
                    app:boxStrokeColor="?attr/colorPrimary"
                    app:hintTextColor="?attr/colorPrimary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/method_dimension_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_dimension"
                        android:inputType="number"
                        android:textColor="?android:textColorPrimary"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="8dp"
                android:background="?attr/colorSecondary"
                android:alpha="0.2"/>

            <ExpandableListView
                android:id="@+id/method_parameters_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:childDivider="@android:color/transparent"
                android:divider="?attr/colorSecondary"
                android:dividerHeight="0.5dp"
                android:groupIndicator="@null"
                android:scrollbars="none" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/delete_method_button"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="64dp"
            android:layout_height="56dp"
            android:layout_marginEnd="12dp"
            android:backgroundTint="@color/danger_red"
            android:elevation="2dp"
            app:cornerRadius="16dp"
            app:icon="@drawable/baseline_delete_forever_black_18dp"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="?attr/colorOnError" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/method_cancel_button"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="64dp"
            android:layout_height="56dp"
            android:layout_marginEnd="12dp"
            android:backgroundTint="?attr/colorSecondary"
            android:elevation="2dp"
            app:cornerRadius="16dp"
            app:icon="@drawable/baseline_cancel_black_18dp"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="?attr/colorOnSecondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/method_ok_button"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="64dp"
            android:layout_height="56dp"
            android:backgroundTint="?attr/colorPrimary"
            android:elevation="2dp"
            app:cornerRadius="16dp"
            app:icon="@drawable/baseline_check_black_18dp"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="?attr/colorOnPrimary" />

    </LinearLayout>

</LinearLayout>