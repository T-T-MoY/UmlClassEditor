<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:windowBackground"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".view.ClassEditorFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/edit_class_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_class_management"
            android:textColor="?attr/colorPrimary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/subtitle_class_management"
            android:textColor="?attr/colorSecondary"
            android:textSize="14sp" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:textColorHint="?attr/colorSecondary"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="?attr/colorPrimary"
                app:hintTextColor="?attr/colorPrimary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/class_name_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_class_name"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/label_structure_type"
                android:textColor="?attr/colorSecondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:scrollbars="none">

                <RadioGroup
                    android:id="@+id/class_type_radio_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/class_java_radio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:buttonTint="?attr/colorPrimary"
                        android:checked="true"
                        android:text="@string/class_type_java"
                        android:textColor="?android:textColorPrimary" />

                    <RadioButton
                        android:id="@+id/class_abstract_radio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:buttonTint="?attr/colorPrimary"
                        android:text="@string/class_type_abstract"
                        android:textColor="?android:textColorPrimary" />

                    <RadioButton
                        android:id="@+id/class_interface_radio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:buttonTint="?attr/colorPrimary"
                        android:text="@string/class_type_interface"
                        android:textColor="?android:textColorPrimary" />

                    <RadioButton
                        android:id="@+id/class_enum_radio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="?attr/colorPrimary"
                        android:text="@string/class_type_enum"
                        android:textColor="?android:textColorPrimary" />
                </RadioGroup>
            </HorizontalScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="12dp"
                android:background="?attr/colorSecondary"
                android:alpha="0.2"/>

            <ExpandableListView
                android:id="@+id/class_members_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:childDivider="@android:color/transparent"
                android:divider="?attr/colorSecondary"
                android:dividerHeight="0.5dp"
                android:groupIndicator="@null"
                android:scrollbars="none" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">


        <com.google.android.material.button.MaterialButton
            android:id="@+id/delete_class_button"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="64dp"
            android:layout_height="56dp"
            android:layout_marginEnd="12dp"
            android:backgroundTint="@color/danger_red"
            android:elevation="2dp"
            app:cornerRadius="16dp"
            app:icon="@drawable/baseline_delete_forever_black_18dp"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="?attr/colorOnError"
            app:strokeColor="@color/danger_red" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/class_cancel_button"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="64dp"
            android:layout_height="56dp"
            android:layout_marginEnd="12dp"
            android:backgroundTint="?attr/colorSecondary"
            android:elevation="2dp"
            app:cornerRadius="16dp"
            app:icon="@drawable/baseline_cancel_black_18dp"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="?attr/colorOnSecondary"
            />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/class_ok_button"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="64dp"
            android:layout_height="56dp"
            android:backgroundTint="?attr/colorPrimary"
            android:elevation="2dp"
            app:cornerRadius="16dp"
            app:icon="@drawable/baseline_check_black_18dp"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="?attr/colorOnPrimary" />

    </LinearLayout>

</LinearLayout>