<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema claro. En values-night se redefine con la paleta oscura. -->
    <style name="Theme.UmlClassEditor" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/light_neon_btn</item>
        <item name="colorPrimaryVariant">@color/light_sidebar_bottom</item>
        <item name="colorOnPrimary">@color/on_primary</item>

        <item name="colorSecondary">@color/light_text_muted</item>
        <item name="colorSecondaryVariant">@color/light_text_muted</item>
        <item name="colorOnSecondary">@color/on_primary</item>

        <item name="colorSurface">@color/light_bg_card</item>
        <item name="colorOnSurface">@color/light_text_main</item>
        <item name="colorError">@color/danger_red</item>
        <item name="colorOnError">@color/on_primary</item>
        <item name="colorOutline">@color/light_border</item>
        <item name="colorControlNormal">@color/light_text_muted</item>
        <item name="colorControlActivated">@color/light_neon_btn</item>

        <item name="android:windowBackground">@color/light_bg_body</item>
        <item name="android:colorBackground">@color/light_bg_body</item>
        <item name="android:textColorPrimary">@color/light_text_main</item>
        <item name="android:textColorSecondary">@color/light_text_muted</item>
        <item name="android:textColorHint">@color/light_text_muted</item>

        <item name="android:statusBarColor">@color/light_bg_card</item>
        <item name="android:navigationBarColor">@color/light_bg_body</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
